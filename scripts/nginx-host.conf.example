# Хостовый nginx — TLS-терминация + проксирование на Docker-контейнер фронта.
#
# УСТАНОВКА:
#   1. Скопировать в /etc/nginx/sites-available/price-monitor
#   2. Заменить example.com на реальный домен
#   3. Поднять Docker (docker compose up -d) — фронт должен слушать 127.0.0.1:8080
#   4. Получить сертификат: sudo certbot --nginx -d example.com -d www.example.com
#      Certbot сам заполнит ssl_certificate, ssl_certificate_key и блок редиректа
#   5. sudo ln -s /etc/nginx/sites-available/price-monitor /etc/nginx/sites-enabled/
#   6. sudo nginx -t && sudo systemctl reload nginx
#
# ПЕРЕМЕННЫЕ В .env (Docker):
#   FRONTEND_BIND_ADDR=127.0.0.1
#   FRONTEND_PORT=8080
#   WEB_BIND_ADDR=127.0.0.1
#   INFRA_BIND_ADDR=127.0.0.1

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # certbot добавит сюда блок редиректа на HTTPS автоматически.
    # Вручную: раскомментировать строки ниже и удалить location-блоки.
    # return 301 https://$host$request_uri;

    # Нужен для ACME-challenge (certbot обновляет сертификат через HTTP).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # До получения сертификата: проксируем HTTP напрямую, чтобы сайт работал.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com www.example.com;

    # Certbot заполнит эти строки после получения сертификата:
    # ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    # include             /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS — включить ПОСЛЕ того как HTTPS точно работает и сайт не нужно
    # откатывать на HTTP. Начать с небольшого значения, потом увеличить.
    # Одновременно поставить SECURE_HSTS_SECONDS=31536000 в .env (Django).
    add_header Strict-Transport-Security "max-age=3600" always;

    # Размер загружаемых файлов (аватар и т.п.)
    client_max_body_size 10m;

    # Проксируем на Docker-контейнер фронта.
    # Фронт сам проксирует /api/, /admin/, /static/ на Django.
    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_buffering    off;
    }
}
