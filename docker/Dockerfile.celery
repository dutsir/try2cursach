FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
    wget \
    gnupg \
    unzip \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libdrm2 \
    libgbm1 \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q -O - https://dl.google.com/linux/linux_signing_key.pub \
    | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
    > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.txt /app/requirements.txt

# Обновить pip + установить torch CPU-only (вместо GPU+CUDA сборки).
# ВАЖНО: версия должна совпадать с веткой torch на хосте (2.12.x) и быть собрана
# под NumPy 2.x. Старый torch 2.1.2+cpu собран под NumPy 1.x и не имеет API
# torch.utils._pytree.register_pytree_node, который требует transformers 4.57 →
# при numpy 2.1.3 модель эмбеддингов не грузилась, дедуп молча падал на Dice.
# Увеличенный timeout и retries для медленного интернета.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        --timeout=600 \
        --retries=20 \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.12.0+cpu

# Установить остальные зависимости (torch уже есть, не будет переустанавливаться)
RUN pip install --no-cache-dir \
    --timeout=600 \
    --retries=20 \
    -r requirements.txt

COPY . /app/

RUN chmod +x /app/docker/celery-entrypoint.sh

ENV DISPLAY=:99

# Fallback-команда (в docker-compose переопределяется). Xvfb поднимается надёжно
# через entrypoint с проверкой готовности X-сервера, а не "выстрелил-и-забыл".
CMD ["/app/docker/celery-entrypoint.sh", "celery", "-A", "config", "worker", "--loglevel=info", "--concurrency=1", "-Q", "parsing_heavy"]
