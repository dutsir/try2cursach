# ============================================================================
# .env для ДОМАШНЕГО DNS-воркера (heavy), который пишет в БД/брокер на VPS.
# ============================================================================
# Архитектура: одна боевая БД живёт на VPS. Дома крутится ТОЛЬКО heavy-воркер
# с Chrome+прогревом (residential-IP), подключённый к VPS по WireGuard.
# Никаких миграций/синков данных: результаты парсинга сразу ложатся в БД VPS.
#
# Запуск дома (под пользователем, НЕ в docker — чтобы профиль не портился root):
#   cp .env.home-dns-worker.example .env        # и подставь реальные значения
#   ./scripts/warmup_dns_profile.sh             # прогрев профиля (ручной, по нужде)
#   CELERY_QUEUES=parsing_heavy CELERY_CONCURRENCY=1 ./scripts/run_celery_worker.sh
#
# ВАЖНО: DB_NAME/DB_USER/DB_PASSWORD и RABBITMQ_USER/PASS должны СОВПАДАТЬ
# с теми, что заданы в .env на VPS — воркер подключается к ТОЙ ЖЕ базе и брокеру.
# ----------------------------------------------------------------------------

# --- Подключение к инфраструктуре VPS через WireGuard ---
# 10.10.0.1 — это WG-адрес VPS-сервера (см. docs/DEPLOY_DNS_WORKER_HOME.md).
DB_HOST=10.10.0.1
DB_PORT=5432
RABBITMQ_HOST=10.10.0.1
RABBITMQ_PORT=5672
REDIS_HOST=10.10.0.1
REDIS_PORT=6379

# --- Секреты: должны совпадать с .env на VPS ---
SECRET_KEY=ДОЛЖЕН-СОВПАДАТЬ-С-VPS
DB_NAME=price_monitor
DB_USER=pm_user
DB_PASSWORD=СОВПАДАЕТ-С-VPS
RABBITMQ_USER=pm_rabbit
RABBITMQ_PASS=СОВПАДАЕТ-С-VPS

DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Chrome для DNS: РЕАЛЬНЫЙ дисплей через Xvfb (НЕ headless) ---
# Так проходит Qrator на прогретом профиле (проверенный рецепт).
CHROME_HEADLESS=0
CHROME_VERSION_MAIN=148
DNS_STEALTH=false
DNS_COOKIES_FILE=
# Тот же профиль, что прогревает warmup_dns_profile.sh:
DNS_USER_DATA_DIR=./var/chrome_profiles/dns

# --- DNS: residential-прокси НЕ нужен дома (домашний IP и так residential).
# Если когда-нибудь будешь гонять DNS-воркер не из дома — впиши сюда residential-прокси.
PROXY_LIST=

# --- Параметры heavy-воркера (Chrome) ---
CELERY_HEAVY_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=10
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_HEAVY_TIME_LIMIT=1800
CELERY_HEAVY_SOFT_TIME_LIMIT=1680

# DNS-скролл каталога (как на боевом)
DNS_CATALOG_SCROLL_MAX_ROUNDS=80
DNS_CATALOG_SCROLL_STABLE=8
DNS_CATALOG_ELEMENT_WAIT=90

# Дедупликация — как на боевом (пишем в общую БД, поведение должно совпадать)
DEDUP_V2=1
DEDUP_AUTO_MERGE_THRESHOLD=0.85
DEDUP_REVIEW_THRESHOLD=0.65
DEDUP_EMBEDDING_MATCH_ENABLED=1
