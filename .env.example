SECRET_KEY=your-super-secret-key-change-me
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip,example.com

# === Прод: домен + HTTPS ===
# Список через запятую, со схемой. Должны совпадать с реальным доменом сайта.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# Django за TLS-прокси (nginx+certbot/Caddy на хосте): доверяем X-Forwarded-Proto,
# чтобы Secure-cookies работали. Оставить 1 при HTTPS-терминации на прокси.
USE_PROXY_SSL_HEADER=1

# === Привязка портов Docker (прод) ===
# web слушает только localhost (наружу не торчит, фронт ходит по внутренней сети).
WEB_BIND_ADDR=127.0.0.1
# Фронт-контейнер за хостовым TLS-прокси: localhost + нестандартный порт,
# чтобы не конфликтовать с nginx/Caddy на 80/443. Прокси шлёт сюда.
FRONTEND_BIND_ADDR=127.0.0.1
FRONTEND_PORT=8080
# БД/брокер слушают только этот адрес. На VPS без WireGuard оставьте 127.0.0.1.
INFRA_BIND_ADDR=127.0.0.1

DB_NAME=price_monitor
DB_USER=pm_user
DB_PASSWORD=pm_secret
# Хосты по умолчанию — localhost, т.к. Celery worker запускается НА ХОСТЕ
# через scripts/run_celery_worker.sh и ходит на проброшенные порты Docker.
# Для контейнерных сервисов (web, celery-worker под profile docker-celery)
# эти переменные ПЕРЕОПРЕДЕЛЯЮТСЯ в docker-compose.yml через environment:
# DB_HOST=postgres, RABBITMQ_HOST=rabbitmq, REDIS_HOST=redis
DB_HOST=localhost
DB_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

REDIS_HOST=localhost
REDIS_PORT=6379

PARSE_DELAY_MIN=1.0
PARSE_DELAY_MAX=3.0
PARSE_MAX_RETRIES=3
PROXY_LIST=

CHROME_HEADLESS=1
# Версия Chrome — пиннинг для undetected_chromedriver (избегаем срывов auto-detection).
# Проверить версию: google-chrome --version
CHROME_VERSION_MAIN=148
CELERY_DNS_CATEGORY_PAUSE_SECONDS=180

# === Celery: память и очереди (важно для VPS 4-8 GB) ===
# Перезапуск дочернего процесса воркера после N задач — освобождает память
# (Chrome/Selenium и torch не всегда отдают её обратно ОС).
CELERY_WORKER_MAX_TASKS_PER_CHILD=10
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Тайм-лимиты задаются ПО ВОРКЕРАМ (тяжёлым Selenium нужно больше времени).
# Тяжёлый (DNS/Citilink/Ozon): большой скролл каталога может идти минуты.
CELERY_HEAVY_TIME_LIMIT=1800
CELERY_HEAVY_SOFT_TIME_LIMIT=1680
# Лёгкий (WB/Regard/служебные): быстрые HTTP-задачи.
CELERY_LIGHT_TIME_LIMIT=600
CELERY_LIGHT_SOFT_TIME_LIMIT=540
# Конкурентность воркеров: тяжёлый (Chrome) держим на 1, лёгкий (HTTP) — 2.
CELERY_HEAVY_CONCURRENCY=1
CELERY_LIGHT_CONCURRENCY=2
# Лимиты памяти контейнеров воркеров (docker compose deploy.resources.limits).
# Тяжёлый: Chrome + длинный скролл каталога DNS берёт >2.5GB. 4g — с запасом
# (на VPS 4GB поставьте 3g и следите за OOM в dmesg; ниже 2.5g будет SIGKILL).
CELERY_HEAVY_MEM_LIMIT=4g
CELERY_LIGHT_MEM_LIMIT=1500m

# DNS: скролл каталога (если мало карточек — увеличьте паузы и MAX_ROUNDS)
DNS_CATALOG_SCROLL_MAX_ROUNDS=80
DNS_CATALOG_SCROLL_STABLE=8
DNS_CATALOG_SCROLL_MIN_ROUNDS=12
DNS_CATALOG_SCROLL_PAUSE_MIN=3.0
DNS_CATALOG_SCROLL_PAUSE_MAX=5.5
DNS_CATALOG_SCROLL_PAUSE_SHORT_MIN=2.0
DNS_CATALOG_SCROLL_PAUSE_SHORT_MAX=3.5
DNS_CATALOG_SCROLL_PAUSE_MORE_MIN=3.5
DNS_CATALOG_SCROLL_PAUSE_MORE_MAX=6.0
DNS_CATALOG_ELEMENT_WAIT=90
# Элемент внизу блока каталога (подгрузка при появлении в viewport)
DNS_CATALOG_SCROLL_SENTINEL_SELECTOR=.spoiler-text-description.spoiler-text-description_layer

# Дедупликация v2 (MPN + specs + scoring). 0 = legacy Dice по имени.
DEDUP_V2=1
DEDUP_SHADOW=0
DEDUP_AUTO_MERGE_THRESHOLD=0.85
DEDUP_REVIEW_THRESHOLD=0.65
DEDUP_REMATCH_ON_UPDATE=1
DEDUP_REMATCH_COOLDOWN_HOURS=24
DEDUP_EMBEDDING_MATCH_ENABLED=1
DEDUP_HF_HUB_TIMEOUT=120
DEDUP_EMBEDDING_LOCAL_FILES_ONLY=0

# === VPS (лёгкий воркер / DEPLOY_MODE=site+wb) ===
# На VPS без HuggingFace-модели эмбеддинги отключить — иначе celery-worker-vps
# упадёт при импорте sentence-transformers (она не установлена в лёгком образе).
# Дедуп работает по MPN+specs без эмбеддингов (DEDUP_V2=1 этого достаточно).
# DEDUP_EMBEDDING_ENABLED=0
# DEDUP_EMBEDDING_MATCH_ENABLED=0

# Ozon: больше скролла и fallback-пагинация при малом числе товаров
OZON_SCROLL_MAX_ROUNDS=50
OZON_SCROLL_MIN_ROUNDS=15
OZON_SCROLL_STABILITY_THRESHOLD=12
OZON_PAGINATION_MAX_PAGES=8

# TimescaleDB hypertable и retention policies (требует расширение timescaledb)
TIMESCALE_ENABLED=1
TIMESCALE_RETENTION_DAYS=365

# === Уведомления о подписках ===
# Минимальный интервал между повторными уведомлениями по одной подписке (часы).
SUBSCRIPTION_NOTIFY_COOLDOWN_HOURS=24

# === Telegram-дублирование уведомлений ===
# Включается флагом + токеном бота (создать через @BotFather). Webhook не нужен —
# periodic-задача telegram-poll-updates забирает getUpdates (включить в админке
# django-celery-beat после установки токена). Без HTTPS работает на любом VPS.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_TIMEOUT=15
TELEGRAM_LINK_CODE_TTL_MINUTES=15

# === Email (SMTP + верификация + уведомления) ===
# В dev (DEBUG=1) EMAIL_BACKEND=console → письма выводятся в docker logs web.
# В проде задать EMAIL_HOST и остальные переменные под свой SMTP-сервер.
# Gmail: EMAIL_HOST=smtp.gmail.com PORT=587 TLS=1 (нужен App Password, не обычный пароль)
# Yandex: EMAIL_HOST=smtp.yandex.ru PORT=587 TLS=1
# Mailgun: EMAIL_HOST=smtp.mailgun.org PORT=587 TLS=1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_FROM=Scout <your@gmail.com>
# URL сайта — подставляется в ссылки писем (без слеша на конце).
SITE_URL=https://example.com

# === Cookies / CSRF (production) ===
# В DEBUG=0 сессионная и CSRF-cookie помечаются Secure (нужен HTTPS).
# Отключить можно COOKIE_SECURE=0 (например, если терминируете TLS на прокси).
COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

