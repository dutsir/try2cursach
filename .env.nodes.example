# .env.nodes.example — шаблон .env для УДАЛЁННОГО узла (парсер или L2-дедуп),
# который ходит в центральный VPS по WireGuard. Скопируй в `.env` на узле и
# подставь реальные значения. Креды БД/брокера ДОЛЖНЫ совпадать с центральным боксом.
#
# Запуск узла (выбрать профиль под роль узла):
#   docker compose -f docker-compose.nodes.yml --profile node-dns      up -d
#   docker compose -f docker-compose.nodes.yml --profile node-wb       up -d
#   docker compose -f docker-compose.nodes.yml --profile node-citilink up -d
#   docker compose -f docker-compose.nodes.yml --profile node-mvideo   up -d
#   docker compose -f docker-compose.nodes.yml --profile node-dedup    up -d

# ---------- Адрес центрального хаба по WireGuard ----------
# Приватный IP центрального VPS в WG-сети (там слушают postgres/rabbitmq/redis).
# На центральном боксе эти порты должны быть привязаны к wg-интерфейсу и закрыты
# фаерволом от всего, кроме подсети WG.
DB_HOST=10.8.0.1
RABBITMQ_HOST=10.8.0.1
REDIS_HOST=10.8.0.1

# ---------- Креды БД (как на центральном боксе) ----------
DB_NAME=price_monitor
DB_USER=pm_user
DB_PASSWORD=__SAME_AS_CENTRAL__
DB_PORT=5432

# ---------- Креды брокера/бэкенда (как на центральном боксе) ----------
RABBITMQ_USER=__SAME_AS_CENTRAL__
RABBITMQ_PASS=__SAME_AS_CENTRAL__
RABBITMQ_PORT=5672
REDIS_PORT=6379

# Явные URL (необязательно — если заданы, перекрывают host/port выше).
# CELERY_BROKER_URL=amqp://USER:PASS@10.8.0.1:5672//
# CELERY_RESULT_BACKEND=redis://10.8.0.1:6379/0

# ---------- Django ----------
DJANGO_SECRET_KEY=__SAME_AS_CENTRAL__
DJANGO_DEBUG=0
# Узлам web не нужен, ALLOWED_HOSTS не критичен, но пусть будет валидным:
DJANGO_ALLOWED_HOSTS=localhost

# ===================================================================
# РОЛЬ УЗЛА: раскомментируй блок под конкретный узел.
# ===================================================================

# --- Парсер-узлы (DNS / WB / Citilink / MVideo): torch НЕ нужен ---
# Эмбеддинги считает отдельный L2-узел, поэтому на парсерах отключаем,
# чтобы матчинг при инжесте не пытался грузить модель.
# DEDUP_EMBEDDING_ENABLED=0
# DEDUP_EMBEDDING_MATCH_ENABLED=0
#
# DNS-узел дополнительно (Qrator-solver):
# DNS_USE_HTTP=1
# DNS_QRATOR_SOLVER=1
# DNS_HTTP_PROXY=            # пусто = прямой IP узла (для DNS проксь не нужна)

# --- L2-дедуп-узел: torch нужен, эмбеддинги включены ---
# DEDUP_EMBEDDING_ENABLED=1
# DEDUP_EMBEDDING_MATCH_ENABLED=1
# DEDUP_L2_SWEEP_ENABLED=1
# DEDUP_L2_LOOKBACK_HOURS=24
# DEDUP_L2_BATCH_LIMIT=500
# DEDUP_MAGNET_GROUP_THRESHOLD=6
# Офлайн-кэш модели (примонтирован в compose как HF_HOME_DIR):
# DEDUP_EMBEDDING_LOCAL_FILES_ONLY=1
# HF_HOME_DIR=/root/.cache/huggingface
